.superpowers/
design/mascotte/references/
.env
apps/brain/alicia.config.yaml
apps/brain/data/
# Test configs and data folders of the manual checks (README); the example config stays versioned
apps/brain/alicia.*.yaml
!apps/brain/alicia.config.example.yaml
apps/brain/data-*/
# Google OAuth client secret (google.clientSecretFile): never versioned
apps/brain/secrets/
