{
  "name": "@alicia/desktop",
  "version": "0.2.0",
  "description": "Alicia, l'assistante de la maison",
  "author": "pandarvis",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "mascot": "tsx scripts/export-mascot.ts"
  },
  "devDependencies": {
    "@alicia/protocol": "workspace:*",
    "@fontsource-variable/nunito": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "bonjour-service": "1.4.4",
    "electron": "^44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0-beta.5",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
